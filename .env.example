# Copy to .env.local. Every value is optional: with nothing set, the app runs fully offline
# (local JSON store + offline rules engine), which is the safest mode for a stage demo.

# Storage. Leave empty to use the local JSON store at .data/pac-db.json
MONGODB_URI=
MONGODB_DB=pac

# LLM provider: auto | groq | claude | ollama | rules
#   auto  = Claude if ANTHROPIC_API_KEY is set, else Groq if GROQ_API_KEY is set, else the offline rules engine
#   rules = deterministic offline engine (no network, no key)
LLM_PROVIDER=auto

# Groq (https://console.groq.com/keys). GROQ_MODEL must be a model listed in your Groq console.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# schema = JSON-schema structured output (falls back automatically) | object = JSON mode only
GROQ_JSON_MODE=schema

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Pause between pipeline steps (ms) so the agent timeline is readable on stage.
# Not counted in the step durations shown in the UI. Set 0 to disable.
PIPELINE_STEP_DELAY_MS=450

# Assumption behind the "estimated minutes saved" KPI (labelled "est." in the UI)
ESTIMATED_MANUAL_MINUTES_PER_PACKET=30
